# Watches the deployed binary; when build.sh (or anything) replaces it, systemd
# starts rusty-cam-restart.service, which runs `systemctl restart rusty-cam`.
#
# Install (Pi, as root) — keep Path= in sync with ExecStart in rusty-cam.service:
#   sudo cp deploy/rusty-cam.service deploy/rusty-cam.path deploy/rusty-cam-restart.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rusty-cam.service rusty-cam.path
#
# rusty-cam-restart.service is not enabled directly; only invoked by this path unit.

[Unit]
Description=Watch rusty-cam binary for updates (scp / deploy)

[Path]
PathChanged=/home/parkerc/binary-rusty-cam
Unit=rusty-cam-restart.service

[Install]
WantedBy=multi-user.target
